# PayReplayy Stage 0 configuration. Do not commit a populated .env file.
NODE_ENV=development
LOG_LEVEL=info

# This must remain dry_run until a staged, written approval enables live actions.
FINANCIAL_ACTIONS_MODE=dry_run

API_HOST=127.0.0.1
API_PORT=3000

# The shared Stage 0 applications do not read these values. A later direct PostgreSQL layer
# uses DATABASE_URL only in the API and worker containers, never the bot or executor.
DATABASE_URL=

# Supabase keys are not database credentials. If needed later, inject them only into the API or
# worker for private Storage/Auth operations; never use them to access the private app schema.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The Telegram bot is deliberately disabled until BotFather setup is complete.
TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_TOKEN=

# The KemerBet executor is deliberately disabled. Setting this true must never
# be treated as authorization for a real financial action by itself.
KEMERBET_EXECUTOR_ENABLED=false
KEMERBET_FINAL_ACTION_ENABLED=false
