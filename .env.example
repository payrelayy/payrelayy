# PayReplayy Stage 0 configuration. Do not commit a populated .env file.
# Production uses separate environment/secret sets per process. Do not mount a bot token
# into the API, worker, executor, dashboard, browser profile, or any shared secret file.
NODE_ENV=development
LOG_LEVEL=info

# API and executor only. This must remain dry_run until a staged, written approval enables live actions.
FINANCIAL_ACTIONS_MODE=dry_run

# API only.
API_HOST=127.0.0.1
API_PORT=3000

# A later direct PostgreSQL layer uses DATABASE_URL only in the API and worker containers,
# never the bot or executor. Stage 0 does not read it.
DATABASE_URL=

# Supabase keys are not database credentials. Stage 0 does not use them. A future private Storage
# boundary must be reviewed separately; never add a Supabase service-role key to any app configuration.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Bot only. Keep both variables out of every other process. The bot does not read the token while disabled.
# The Telegram bot is deliberately disabled until BotFather setup is complete.
TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_TOKEN=

# Bot only when TELEGRAM_BOT_ENABLED=true. This must be a private Docker-network API origin,
# never a browser/public URL. The HMAC secret is exactly 32 random bytes as lowercase hex.
BOT_TO_API_INGRESS_BASE_URL=
BOT_TO_API_INGRESS_HMAC_SECRET=

# API only. Both keys are read only when this remains explicitly enabled. It must stay false until
# a durable cross-replica nonce guard and direct-PostgreSQL inbox recorder have been reviewed.
INTERNAL_TELEGRAM_INGRESS_ENABLED=false
API_TELEGRAM_PAYLOAD_HMAC_SECRET=

# Executor only. The KemerBet executor is deliberately disabled. Setting this true must never
# be treated as authorization for a real financial action by itself.
KEMERBET_EXECUTOR_ENABLED=false
KEMERBET_FINAL_ACTION_ENABLED=false
