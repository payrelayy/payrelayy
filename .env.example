# FetanAgent Stage 0 configuration. Do not commit a populated .env file.
# Production uses separate environment/secret sets per process. Do not mount a bot token
# into the API, worker, executor, dashboard, browser profile, or any shared secret file.
NODE_ENV=development
LOG_LEVEL=info

# API and executor only. This must remain dry_run until a staged, written approval enables live actions.
FINANCIAL_ACTIONS_MODE=dry_run

# API only.
API_HOST=127.0.0.1
API_PORT=3000

# API only. This permits the manual database preflight to read DATABASE_URL only when explicitly
# true. It does not create an API database pool or Telegram route unless the separate private
# ingress runtime gate is also true with every required ingress prerequisite.
INTERNAL_POSTGRES_RUNTIME_ENABLED=false

# API runtime secret only. Use a dedicated non-admin PostgreSQL login and a TLS-protected direct
# or Supavisor session-pooler URL from Supabase's Connect panel. Never paste a real value here.
DATABASE_URL=

# Maintenance only. This optional manual privilege preflight is disabled by default and is never
# loaded by the API, bot, worker, executor, or a shared environment file. It has no purge command
# or scheduler in this stage. Use a distinct non-admin maintenance login with sslmode=verify-full.
INTERNAL_NONCE_RETENTION_RUNTIME_ENABLED=false
NONCE_RETENTION_DATABASE_URL=

# Supabase keys are not database credentials. Stage 0 does not use them. A future private Storage
# boundary must be reviewed separately; never add a Supabase service-role key to any app configuration.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Dedicated Owner-control service only. Default false. This service verifies a Supabase bearer
# token with the staging Auth API, then uses its own narrow PostgreSQL role to issue or revoke a
# digest-only beta invite. It never accepts an actor ID from the browser and never uses service_role.
INTERNAL_OWNER_CONTROL_RUNTIME_ENABLED=false
OWNER_CONTROL_HOST=127.0.0.1
OWNER_CONTROL_PORT=3002
OWNER_CONTROL_SUPABASE_URL=
OWNER_CONTROL_DATABASE_URL=
OWNER_CONTROL_SUPABASE_PUBLISHABLE_KEY=

# Bot only. Keep both variables out of every other process. The bot does not read the token while disabled.
# The Telegram bot is deliberately disabled until BotFather setup is complete.
TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_TOKEN=

# Bot only when TELEGRAM_BOT_ENABLED=true. This must be a private Docker-network API origin,
# never a browser/public URL. The HMAC secret is exactly 32 random bytes as lowercase hex.
BOT_TO_API_INGRESS_BASE_URL=
BOT_TO_API_INGRESS_HMAC_SECRET=

# API only. Both keys are read only when this remains explicitly enabled. It does not register a
# route or create a database pool without the separate private ingress runtime gate below.
INTERNAL_TELEGRAM_INGRESS_ENABLED=false
API_TELEGRAM_PAYLOAD_HMAC_SECRET=

# API only. Default false. This is the final runtime-composition gate for the private Telegram
# route and its narrow PostgreSQL adapters. It can be true only when both INTERNAL_POSTGRES_RUNTIME_ENABLED
# and INTERNAL_TELEGRAM_INGRESS_ENABLED are true with their reviewed credentials. It does not start
# bot polling, Player-ID processing, payment verification, or any financial action.
INTERNAL_TELEGRAM_PRIVATE_INGRESS_RUNTIME_ENABLED=false

# Bot and API only. Default false. This is a separately authenticated private Player-ID action
# envelope. The reviewed staging profile may enable it only with the dedicated runtime below. It
# never authorizes Player-ID validation, a payment, a deposit, a withdrawal, or a KemerBet action.
# The HMAC must be distinct from every other Telegram HMAC.
INTERNAL_TELEGRAM_ACTION_CHANNEL_ENABLED=false
BOT_TO_API_ACTION_BASE_URL=
BOT_TO_API_ACTION_HMAC_SECRET=

# API only. These must differ from each other and from enabled transport/payload HMAC keys.
INTERNAL_TELEGRAM_ACTION_CAPABILITY_CONTRACT_ENABLED=false
API_TELEGRAM_CAPABILITY_HMAC_SECRET=
API_TELEGRAM_ACTION_SEMANTIC_HMAC_SECRET=
API_DEPOSIT_REFERENCE_PROTECTION_SECRET=

# API only. Default false. This composes the isolated staging Player-ID runtime only when both
# action gates above are enabled. The URL must use the dedicated staging Player-ID login with
# sslmode=verify-full. The payload HMAC must be distinct from every other Telegram HMAC. This
# runtime records admitted events and pending Player-ID requests only; validation and every
# financial/provider action remain disabled.
INTERNAL_TELEGRAM_PLAYER_ACTION_RUNTIME_ENABLED=false
PLAYER_ACTION_DATABASE_URL=
API_TELEGRAM_PLAYER_ACTION_PAYLOAD_HMAC_SECRET=

# Executor only. The KemerBet executor is deliberately disabled. Setting this true must never
# be treated as authorization for a real financial action by itself.
KEMERBET_EXECUTOR_ENABLED=false
KEMERBET_FINAL_ACTION_ENABLED=false
