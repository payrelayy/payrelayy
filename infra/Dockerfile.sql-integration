# Isolated test runner for the disposable SQL integration harness.
# It contains the test package, migrations, operational SQL, and only the two API adapter
# modules needed for a no-money integration test. No application entry point, production
# credential, environment file, or host socket is included.
FROM --platform=linux/amd64 public.ecr.aws/docker/library/node:22.17.1-bookworm-slim@sha256:ffb27ca0f26a231a08930c872631cea70cbb318463d1e712922b5c7cfdc3fcca AS dependencies

WORKDIR /workspace

RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json ./apps/api/package.json
COPY packages/sql-integration-tests/package.json ./packages/sql-integration-tests/package.json
COPY packages/config/package.json ./packages/config/package.json
COPY packages/contracts/package.json ./packages/contracts/package.json
COPY packages/deposit-reference-protection/package.json \
  ./packages/deposit-reference-protection/package.json
COPY packages/domain/package.json ./packages/domain/package.json
COPY packages/agent-platform-companion-contracts/package.json \
  ./packages/agent-platform-companion-contracts/package.json
COPY packages/agent-platform-companion-execution-contracts/package.json \
  ./packages/agent-platform-companion-execution-contracts/package.json
COPY packages/agent-platform-companion-activation-issuer/package.json \
  ./packages/agent-platform-companion-activation-issuer/package.json

RUN pnpm install --frozen-lockfile \
  --filter @fetanagent/sql-integration-tests... \
  --filter @fetanagent/api...

# Build only the pure package dependencies imported by the test adapters.
# None of these packages supplies a credential or starts an application runtime.
FROM dependencies AS test-dependency-build

COPY tsconfig.base.json ./
COPY packages/domain/tsconfig.json ./packages/domain/tsconfig.json
COPY packages/domain/src ./packages/domain/src
COPY packages/contracts/tsconfig.json ./packages/contracts/tsconfig.json
COPY packages/contracts/src ./packages/contracts/src
COPY packages/config/tsconfig.json ./packages/config/tsconfig.json
COPY packages/config/src ./packages/config/src
COPY packages/deposit-reference-protection/tsconfig.json \
  ./packages/deposit-reference-protection/tsconfig.json
COPY packages/deposit-reference-protection/src ./packages/deposit-reference-protection/src
COPY packages/agent-platform-companion-contracts/tsconfig.json \
  ./packages/agent-platform-companion-contracts/tsconfig.json
COPY packages/agent-platform-companion-contracts/src \
  ./packages/agent-platform-companion-contracts/src
COPY packages/agent-platform-companion-execution-contracts/tsconfig.json \
  ./packages/agent-platform-companion-execution-contracts/tsconfig.json
COPY packages/agent-platform-companion-execution-contracts/src \
  ./packages/agent-platform-companion-execution-contracts/src
COPY packages/agent-platform-companion-activation-issuer/tsconfig.json \
  ./packages/agent-platform-companion-activation-issuer/tsconfig.json
COPY packages/agent-platform-companion-activation-issuer/src \
  ./packages/agent-platform-companion-activation-issuer/src

RUN pnpm --filter @fetanagent/config... \
  --filter @fetanagent/contracts... \
  --filter @fetanagent/deposit-reference-protection... \
  --filter @fetanagent/agent-platform-companion-activation-issuer... run build

# This content-addressed stage supplies the exact psql 17.4 client. Its server entrypoint is
# replaced below; no PostgreSQL daemon or data directory is used by the test runner.
FROM --platform=linux/amd64 public.ecr.aws/docker/library/postgres:17.4-bookworm@sha256:304ab813518754228f9f792f79d6da36359b82d8ecf418096c636725f8c930ad AS runner

WORKDIR /workspace

ENV CI=true
ENV SQL_INTEGRATION_RUNNER_SENTINEL=fetanagent-sql-integration-image-v1

COPY --from=dependencies /usr/local/bin/node /usr/local/bin/node

RUN test "$(node --version)" = 'v22.17.1' \
  && psql --version | grep --extended-regexp --quiet '^psql \(PostgreSQL\) 17\.4([ .]|$)' \
  && psql --help=commands >/tmp/psql-commands \
  && grep --fixed-strings --quiet '\getenv' /tmp/psql-commands \
  && grep --fixed-strings --quiet '\if' /tmp/psql-commands \
  && grep --fixed-strings --quiet '\warn' /tmp/psql-commands \
  && rm -f -- /tmp/psql-commands \
  && groupadd --gid 10001 node \
  && useradd --uid 10001 --gid 10001 --create-home --shell /bin/false node \
  && install --directory --owner=root --group=root --mode=0755 /usr/local/share/fetanagent \
  && printf '%s\n' "$SQL_INTEGRATION_RUNNER_SENTINEL" > /usr/local/share/fetanagent/sql-integration-runner \
  && chmod 0444 /usr/local/share/fetanagent/sql-integration-runner

COPY --from=dependencies /workspace/node_modules ./node_modules
COPY package.json pnpm-workspace.yaml tsconfig.base.json ./
COPY packages/sql-integration-tests ./packages/sql-integration-tests
COPY --from=test-dependency-build /workspace/packages/domain/package.json \
  ./packages/domain/package.json
COPY --from=test-dependency-build /workspace/packages/domain/dist ./packages/domain/dist
COPY --from=test-dependency-build /workspace/packages/contracts/package.json \
  ./packages/contracts/package.json
COPY --from=test-dependency-build /workspace/packages/contracts/dist ./packages/contracts/dist
COPY --from=test-dependency-build /workspace/packages/config/package.json \
  ./packages/config/package.json
COPY --from=test-dependency-build /workspace/packages/config/dist ./packages/config/dist
COPY --from=test-dependency-build /workspace/packages/deposit-reference-protection/package.json \
  ./packages/deposit-reference-protection/package.json
COPY --from=test-dependency-build /workspace/packages/deposit-reference-protection/dist \
  ./packages/deposit-reference-protection/dist
COPY --from=test-dependency-build /workspace/packages/agent-platform-companion-activation-issuer/package.json \
  ./packages/agent-platform-companion-activation-issuer/package.json
COPY --from=test-dependency-build /workspace/packages/agent-platform-companion-activation-issuer/dist \
  ./packages/agent-platform-companion-activation-issuer/dist
COPY apps/api/package.json ./apps/api/package.json
COPY apps/api/src/telegram-action-capability.ts ./apps/api/src/telegram-action-capability.ts
COPY apps/api/src/telegram-routine-telebirr-candidate-intake.ts \
  ./apps/api/src/telegram-routine-telebirr-candidate-intake.ts
COPY apps/telebirr-assignment-broker/src/routine-no-money-runtime.ts \
  ./apps/telebirr-assignment-broker/src/routine-no-money-runtime.ts
COPY apps/telebirr-assignment-broker/src/routine-no-money-postgres.ts \
  ./apps/telebirr-assignment-broker/src/routine-no-money-postgres.ts
COPY apps/telebirr-assignment-broker/src/routine-paid-poll-runtime.ts \
  ./apps/telebirr-assignment-broker/src/routine-paid-poll-runtime.ts
COPY apps/telebirr-assignment-broker/src/routine-paid-poll-postgres.ts \
  ./apps/telebirr-assignment-broker/src/routine-paid-poll-postgres.ts
COPY apps/admin/src/postgres-runtime.ts ./apps/admin/src/postgres-runtime.ts
COPY packages/agent-platform-companion-operator-host/src/activation-diagnostic.ts \
  ./packages/agent-platform-companion-operator-host/src/activation-diagnostic.ts
COPY infra/sql/staging-runtimes-enable-continuous.sql ./infra/sql/staging-runtimes-enable-continuous.sql
COPY infra/sql/staging-telebirr-shadow-verifier-provision.sql \
  ./infra/sql/staging-telebirr-shadow-verifier-provision.sql
COPY infra/sql/staging-telebirr-shadow-verifier-status.sql \
  ./infra/sql/staging-telebirr-shadow-verifier-status.sql
COPY infra/sql/staging-telebirr-shadow-verifier-disable.sql \
  ./infra/sql/staging-telebirr-shadow-verifier-disable.sql
COPY infra/sql/production-live-telebirr-network-binding-recovery.sql \
  ./infra/sql/production-live-telebirr-network-binding-recovery.sql
COPY infra/sql/production-live-telebirr-network-binding-eligibility.sql \
  ./infra/sql/production-live-telebirr-network-binding-eligibility.sql
COPY infra/sql/production-live-telebirr-network-binding-status.sql \
  ./infra/sql/production-live-telebirr-network-binding-status.sql
COPY infra/sql/production-live-telebirr-network-binding-observe.sql \
  ./infra/sql/production-live-telebirr-network-binding-observe.sql
COPY infra/sql/production-live-telebirr-source-document-recovery.sql \
  ./infra/sql/production-live-telebirr-source-document-recovery.sql
COPY infra/sql/production-live-telebirr-source-document-eligibility.sql \
  ./infra/sql/production-live-telebirr-source-document-eligibility.sql
COPY infra/sql/production-live-telebirr-source-document-status.sql \
  ./infra/sql/production-live-telebirr-source-document-status.sql
COPY infra/sql/production-live-telebirr-pin-handoff-late-eligibility.sql \
  ./infra/sql/production-live-telebirr-pin-handoff-late-eligibility.sql
COPY infra/sql/production-live-telebirr-pin-handoff-late-arm.sql \
  ./infra/sql/production-live-telebirr-pin-handoff-late-arm.sql
COPY infra/sql/production-companion-execution-activation-status.sql \
  ./infra/sql/production-companion-execution-activation-status.sql
COPY infra/sql/production-review-emergency-stopped-paid-job.sql \
  ./infra/sql/production-review-emergency-stopped-paid-job.sql
COPY infra/sql/production-resolve-emergency-stopped-owner-test.sql \
  ./infra/sql/production-resolve-emergency-stopped-owner-test.sql
COPY infra/sql/production-companion-execution-emergency-disable.sql \
  ./infra/sql/production-companion-execution-emergency-disable.sql
COPY infra/sql/production-companion-activation-diagnostic-request.sql \
  ./infra/sql/production-companion-activation-diagnostic-request.sql
COPY infra/sql/production-companion-activation-diagnostic-pooler-request.sql \
  ./infra/sql/production-companion-activation-diagnostic-pooler-request.sql
COPY --from=dependencies /workspace/packages/sql-integration-tests/node_modules \
  ./packages/sql-integration-tests/node_modules
COPY --from=dependencies /workspace/apps/api/node_modules ./apps/api/node_modules
COPY --from=dependencies /workspace/packages/config/node_modules ./packages/config/node_modules
COPY --from=dependencies /workspace/packages/contracts/node_modules ./packages/contracts/node_modules
COPY supabase/migrations ./supabase/migrations

# Vite creates a transient bundled config here. Keep all test source and
# migration input root-owned; only this disposable scratch directory is writable.
RUN install --directory --owner=node --group=node --mode=0700 \
  /workspace/packages/sql-integration-tests/node_modules/.vite-temp

WORKDIR /workspace/packages/sql-integration-tests

ENV HOME=/home/node

USER node

# The client image declares PGDATA/PG version metadata. Remove that inherited PG-prefixed metadata
# before the harness's own environment attestation runs; individual psql children receive only the
# explicit disposable connection variables assembled by the test suite.
ENTRYPOINT ["/usr/bin/env", "-u", "PGDATA", "-u", "PG_MAJOR", "-u", "PG_VERSION", "-u", "PG_SHA256"]

CMD ["./node_modules/.bin/vitest", "run", "--config", "vitest.config.ts"]
