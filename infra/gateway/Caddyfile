{
	admin off
	servers {
		protocols h1 h2
	}
}

(security_headers) {
	header {
		-Server
		Strict-Transport-Security "max-age=86400"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
	}
}

fetanagent.com, www.fetanagent.com {
	import security_headers
	encode zstd gzip
	reverse_proxy customer-web:3003 {
		health_uri /healthz
		health_interval 30s
		health_timeout 3s
		transport http {
			dial_timeout 5s
			response_header_timeout 30s
		}
	}
}

owner.fetanagent.com {
	import security_headers
	@root path /
	redir @root /owner 302
	reverse_proxy owner-control:3002 {
		health_uri /healthz
		health_interval 30s
		health_timeout 3s
		transport http {
			dial_timeout 5s
			response_header_timeout 30s
		}
	}
}

device.fetanagent.com {
	import security_headers

	@companion_device_bridge {
		method POST
		path /v1/companion/device/enrollments:pair /v1/companion/device/lookup-assignments:poll /v1/companion/device/lookup-results:submit
		header Content-Type application/vnd.fetanagent.companion-device-bridge+json
		header Accept application/vnd.fetanagent.companion-device-bridge+json
	}

	handle @companion_device_bridge {
		request_body {
			max_size 64KiB
		}
		reverse_proxy companion-device-bridge:8085 {
			transport http {
				dial_timeout 3s
				response_header_timeout 15s
			}
		}
	}

	@telebirr_device_bridge {
		method POST
		path /v1/telebirr/device/enrollments:pair /v1/telebirr/device/assignments:poll /v1/telebirr/device/heartbeat /v1/telebirr/device/observations:upload
		header Content-Type application/vnd.fetanagent.telebirr-device-bridge+json
	}

	handle @telebirr_device_bridge {
		request_body {
			max_size 256KiB
		}
		reverse_proxy telebirr-device-bridge:8084 {
			transport http {
				dial_timeout 3s
				response_header_timeout 15s
			}
		}
	}

	respond 404
}
