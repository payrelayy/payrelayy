{
	admin off
	servers {
		protocols h1 h2
	}
}

(security_headers) {
	header {
		-Server
		Strict-Transport-Security "max-age=86400"
		X-Content-Type-Options "nosniff"
		?Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
	}
}

fetanagent.com, www.fetanagent.com {
	import security_headers
	encode zstd gzip
	reverse_proxy customer-web:3003 {
		# Caddy's default X-Forwarded-For/Host/Proto handling ignores incoming values.
		# Keep trusted_proxies unset: the public connection, not a supplied header, is authoritative.
		health_uri /healthz
		health_interval 30s
		health_timeout 3s
		transport http {
			dial_timeout 5s
			response_header_timeout 30s
		}
	}
}

owner.fetanagent.com {
	import security_headers
	@root path /
	redir @root /owner 302
	reverse_proxy owner-control:3002 {
		health_uri /healthz
		health_interval 30s
		health_timeout 3s
		transport http {
			dial_timeout 5s
			response_header_timeout 30s
		}
	}
}

device.fetanagent.com {
	import security_headers

	@companion_device_bridge {
		method POST
		path /v1/companion/device/enrollments:pair /v1/companion/device/lookup-assignments:poll /v1/companion/device/lookup-results:submit /v2/companion/device/execution-assignments:poll /v2/companion/device/execution-authorities:consume /v2/companion/device/execution-results:submit /v2/companion/device/execution-status:query /v3/companion/device/routine-deposits:command
		header Content-Type application/vnd.fetanagent.companion-device-bridge+json
		header Accept application/vnd.fetanagent.companion-device-bridge+json
	}

	handle @companion_device_bridge {
		request_body {
			max_size 64KiB
		}
		reverse_proxy {$FETANAGENT_COMPANION_BRIDGE_UPSTREAM:companion-device-bridge:8085} {
			transport http {
				dial_timeout 3s
				response_header_timeout 15s
			}
		}
	}

	# BEGIN exact TeleBirr device routing contract
	@staging_telebirr_device_bridge {
		method POST
		path /v1/telebirr/device/enrollments:pair /v1/telebirr/device/assignments:poll /v1/telebirr/device/heartbeat /v1/telebirr/device/observations:upload
		expression `{http.request.header.Content-Type} == "application/vnd.fetanagent.telebirr-device-bridge+json" && {http.request.header.X-FetanAgent-Deployment-Target} == "staging"`
	}
	@production_telebirr_device_bridge {
		method POST
		path /v1/telebirr/device/enrollments:pair /v1/telebirr/device/assignments:poll /v1/telebirr/device/heartbeat /v1/telebirr/device/observations:upload
		expression `{http.request.header.Content-Type} == "application/vnd.fetanagent.telebirr-device-bridge+json" && {http.request.header.X-FetanAgent-Deployment-Target} == "production"`
	}
	@invalid_telebirr_device_target {
		method POST
		path /v1/telebirr/device/enrollments:pair /v1/telebirr/device/assignments:poll /v1/telebirr/device/heartbeat /v1/telebirr/device/observations:upload
		expression `{http.request.header.Content-Type} == "application/vnd.fetanagent.telebirr-device-bridge+json"`
		header X-FetanAgent-Deployment-Target *
	}
	@legacy_telebirr_device_bridge {
		method POST
		path /v1/telebirr/device/enrollments:pair /v1/telebirr/device/assignments:poll /v1/telebirr/device/heartbeat /v1/telebirr/device/observations:upload
		expression `{http.request.header.Content-Type} == "application/vnd.fetanagent.telebirr-device-bridge+json"`
		header !X-FetanAgent-Deployment-Target
	}

	# Placeholder equality sees repeated request fields as one comma-joined value.
	# Exact staging/production values therefore match only one semantic value;
	# duplicates, comma lists, case-confused values, and every other present value
	# fall through to the rejecting target branch before the header-absent legacy route.
	handle @staging_telebirr_device_bridge {
		request_body {
			max_size 256KiB
		}
		reverse_proxy staging-device-pilot-bridge:8084 {
			transport http {
				dial_timeout 3s
				response_header_timeout 15s
			}
		}
	}

	handle @production_telebirr_device_bridge {
		request_body {
			max_size 256KiB
		}
		reverse_proxy telebirr-device-bridge:8084 {
			transport http {
				dial_timeout 3s
				response_header_timeout 15s
			}
		}
	}

	handle @invalid_telebirr_device_target {
		respond 404
	}

	handle @legacy_telebirr_device_bridge {
		request_body {
			max_size 256KiB
		}
		reverse_proxy telebirr-device-bridge:8084 {
			transport http {
				dial_timeout 3s
				response_header_timeout 15s
			}
		}
	}
	# END exact TeleBirr device routing contract

	# BEGIN exact routine no-money routing contract
	# The routine phone rehearsal is production-only and review-only. An absent,
	# staging, repeated, or unexpected target never reaches the bridge.
	@production_telebirr_routine_no_money {
		method POST
		path /v1/telebirr/routine/assignments:poll /v1/telebirr/routine/observations:upload
		expression `{http.request.header.Content-Type} == "application/vnd.fetanagent.telebirr-routine-no-money.v1+json" && {http.request.header.X-FetanAgent-Deployment-Target} == "production"`
	}

	handle @production_telebirr_routine_no_money {
		request_body {
			max_size 48KiB
		}
		reverse_proxy telebirr-device-bridge:8084 {
			transport http {
				dial_timeout 3s
				response_header_timeout 15s
			}
		}
	}
	# END exact routine no-money routing contract

	# BEGIN exact routine paid-poll routing contract
	# The paid-work poll has its own path and media type. A production bridge with
	# the paid handler disabled still rejects it; this route is not a credit API.
	@production_telebirr_routine_paid_poll {
		method POST
		path /v1/telebirr/routine/paid/assignments:poll
		expression `{http.request.header.Content-Type} == "application/vnd.fetanagent.telebirr-routine-paid-poll.v1+json" && {http.request.header.X-FetanAgent-Deployment-Target} == "production"`
	}

	handle @production_telebirr_routine_paid_poll {
		request_body {
			max_size 4KiB
		}
		reverse_proxy telebirr-device-bridge:8084 {
			transport http {
				dial_timeout 3s
				response_header_timeout 15s
			}
		}
	}
	# END exact routine paid-poll routing contract

	# BEGIN exact routine paid-observation routing contract
	# The bridge keeps this path closed unless the separately gated paid upload
	# handler is composed. A signed observation is not a payment claim or credit.
	@production_telebirr_routine_paid_upload {
		method POST
		path /v1/telebirr/routine/paid/observations:upload
		expression `{http.request.header.Content-Type} == "application/vnd.fetanagent.telebirr-routine-paid-observation.v1+json" && {http.request.header.X-FetanAgent-Deployment-Target} == "production"`
	}

	handle @production_telebirr_routine_paid_upload {
		request_body {
			max_size 48KiB
		}
		reverse_proxy telebirr-device-bridge:8084 {
			transport http {
				dial_timeout 3s
				response_header_timeout 15s
			}
		}
	}
	# END exact routine paid-observation routing contract

	respond 404
}
