{
	admin off
	servers {
		protocols h1 h2
	}
}

(security_headers) {
	header {
		-Server
		Strict-Transport-Security "max-age=86400"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
	}
}

fetanagent.com, www.fetanagent.com {
	import security_headers
	header Content-Security-Policy "default-src 'none'; style-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
	encode zstd gzip
	root * /srv
	file_server
}

owner.fetanagent.com {
	import security_headers
	@root path /
	redir @root /owner 302
	reverse_proxy owner-control:3002 {
		health_uri /healthz
		health_interval 30s
		health_timeout 3s
		transport http {
			dial_timeout 5s
			response_header_timeout 30s
		}
	}
}
