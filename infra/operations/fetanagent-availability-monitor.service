[Unit]
Description=FetanAgent read-only availability checks and Owner incident email
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 -I -B /usr/local/lib/fetanagent/fetanagent-availability-monitor.py
TimeoutStartSec=50s
SuccessExitStatus=1
UMask=0077
StateDirectory=fetanagent-availability-monitor
StateDirectoryMode=0700
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
ReadWritePaths=/var/lib/fetanagent-availability-monitor
MemoryMax=128M
TasksMax=32
StandardOutput=journal
StandardError=journal
