{
  "name": "payreplayy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run build",
    "test": "pnpm build && pnpm -r --filter=!@payreplayy/sql-integration-tests run test",
    "test:infra": "node infra/verify-staging-beta.mjs && node infra/verify-staging-beta-runtime-preflight.mjs && node infra/verify-staging-beta-runtime-credential-diagnostic.mjs && node infra/verify-staging-beta-deploy.mjs && node infra/verify-staging-first-owner-bootstrap.mjs",
    "test:sql": "node scripts/run-sql-integration.mjs",
    "lint": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.5.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  }
}
